# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google AI Studio API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: your numeric Telegram user ID to restrict bot access (find it from @userinfobot)
# If left empty, the bot responds to any user who messages it.
ALLOWED_USER_ID=
